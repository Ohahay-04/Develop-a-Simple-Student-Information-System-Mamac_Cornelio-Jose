-- 1. Create the Database
CREATE DATABASE IF NOT EXISTS student_information_system;

-- 2. Switch to the new database
USE student_information_system; 

-- 3. Create the students table
-- This table includes the primary key and all required student attributes [cite: 31, 32]
CREATE TABLE IF NOT EXISTS students (
    student_id INT AUTO_INCREMENT PRIMARY KEY, -- Auto-incremented ID [cite: 33]
    first_name VARCHAR(100),                   -- Student's first name [cite: 34]
    last_name VARCHAR(100),                    -- Student's last name [cite: 35]
    age INT,                                   -- Student's age [cite: 36]
    email VARCHAR(100)                         -- Student's email address [cite: 37]
);

-- 4. Verify the structure
DESCRIBE students;
